CC ?= cc
CFLAGS ?= -O2 -g -std=gnu99 -Wall -Wextra -Werror
FORMAT_CFLAGS ?= -O2 -g -std=gnu89 -Wall -Wextra
FORMAT_CPPFLAGS = -DNeXT -DNeXT_MOD -DNeXT_NFS -DFORMAT_NO_MAIN -Iinclude

BIN = nextufs.mkimg
FSCK_BIN = ../nextufs.fsck/nextufs.fsck
FORMAT_SRCS = format/format.c format/format_fsinit.c format/format_io.c \
	format/format_state.c
FORMAT_OBJS = $(FORMAT_SRCS:format/%.c=%.o)
OBJS = nextufs_mkimg.o $(FORMAT_OBJS)
SCRATCH_DIR = $(CURDIR)/.scratch

.PHONY: all clean test scratch-dir fsck-tool

all: scratch-dir $(BIN)

scratch-dir:
	mkdir -p $(SCRATCH_DIR)

fsck-tool:
	$(MAKE) -C ../nextufs.fsck -f Makefile.linux

$(BIN): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS)

nextufs_mkimg.o: nextufs_mkimg.c format/format.h
	$(CC) $(CFLAGS) $(FORMAT_CPPFLAGS) -Iformat -c -o $@ nextufs_mkimg.c

%.o: format/%.c format/format.h
	$(CC) $(FORMAT_CPPFLAGS) $(FORMAT_CFLAGS) -c -o $@ $<

test: all fsck-tool
	rm -f $(SCRATCH_DIR)/mkimg-raw.img $(SCRATCH_DIR)/mkimg-labeled.img \
		$(SCRATCH_DIR)/mkimg-raw-full.img
	./$(BIN) --raw $(SCRATCH_DIR)/mkimg-raw.img 64M >/dev/null
	$(FSCK_BIN) -n $(SCRATCH_DIR)/mkimg-raw.img >/dev/null
	./$(BIN) $(SCRATCH_DIR)/mkimg-labeled.img 64M >/dev/null
	$(FSCK_BIN) -n $(SCRATCH_DIR)/mkimg-labeled.img >/dev/null
	../nextufs/nextufs_probe $(SCRATCH_DIR)/mkimg-labeled.img >/dev/null
	./$(BIN) --raw $(SCRATCH_DIR)/mkimg-raw-full.img 65536 63 16 8192 1024 16 10 60 2048 t >/dev/null
	$(FSCK_BIN) -n $(SCRATCH_DIR)/mkimg-raw-full.img >/dev/null

clean:
	rm -f *.o $(BIN)
