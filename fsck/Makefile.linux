CC = cc
FSCK_WARN_CFLAGS = -O2 -g -std=gnu89 -fcommon -Wall -Wextra
ARCH_CFLAGS ?=
FSCK_NEXT_CFLAGS = $(ARCH_CFLAGS) $(FSCK_WARN_CFLAGS)
PROBE_CFLAGS = -O2 -g -std=gnu99 -Wall -Wextra -Werror
CPPFLAGS = -DNeXT=1 -DNeXT_MOD=1 -DFASTLINK=1 -Iinclude
SCRATCH_DIR = $(CURDIR)/.scratch
export TMPDIR = $(SCRATCH_DIR)

.PHONY: all clean scratch-dir

all: scratch-dir fsck_probe fsck_next

scratch-dir:
	mkdir -p $(SCRATCH_DIR)

fsck_probe: fsck_ro.o
	$(CC) $(PROBE_CFLAGS) -o $@ fsck_ro.o

FSCK_NEXT_SRCS = dir.c inode.c main.c pass1.c pass1b.c pass2.c pass3.c \
	pass4.c pass5.c setup.c utilities.c ufs_tables.c ufs_subr_user.c \
	byteorder.c

FSCK_NEXT_OBJS = $(patsubst %.c,.build-next/%.o,$(FSCK_NEXT_SRCS))

fsck_next: $(FSCK_NEXT_OBJS)
	$(CC) $(FSCK_NEXT_CFLAGS) -o $@ $(FSCK_NEXT_OBJS)

.build-next/%.o: %.c
	mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(FSCK_NEXT_CFLAGS) -c -o $@ $<

fsck_ro.o: fsck_ro.c
	$(CC) $(PROBE_CFLAGS) -c -o $@ $<

clean:
	rm -f fsck_probe fsck_next fsck_next32 fsck_next64 fsck_ro.o
	rm -rf .build-next .build-next32 .build-next64
