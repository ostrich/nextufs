CC = cc
WARN_CFLAGS = -O2 -g -std=gnu99 -fcommon -Wall -Wextra
ARCH_CFLAGS ?=
CFLAGS = $(ARCH_CFLAGS) $(WARN_CFLAGS)
CPPFLAGS = -DNeXT=1 -DNeXT_MOD=1 -DFASTLINK=1 -Iinclude

SCRATCH_DIR = $(CURDIR)/.scratch
TESTS_DIR = $(CURDIR)/tests
REPAIR_TOOL_BIN = $(TESTS_DIR)/tools/corrupt_raw_case
export TMPDIR = $(SCRATCH_DIR)

BIN = fsck.nextufs
SRCS = alloc_map.c buffer.c byteorder.c device.c dir_repair.c dir_scan.c \
	frag_support.c inode_ops.c inode_scan.c main.c operator.c pass1.c \
	pass1b.c pass2.c pass3.c pass4.c pass5.c session.c setup.c source.c \
	state.c
OBJS = $(patsubst %.c,.build-next/%.o,$(SRCS))

.PHONY: all clean test scratch-dir repair-tools repair-lab repair-smoke repair-repair-all repair-parity-smoke repair-parity-all

all: scratch-dir $(BIN)

scratch-dir:
	mkdir -p $(SCRATCH_DIR)

$(BIN): $(OBJS) ../nextufs/libnextufs.a
	$(CC) $(CFLAGS) -o $@ $(OBJS) ../nextufs/libnextufs.a

.build-next/%.o: %.c
	mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

../nextufs/libnextufs.a:
	$(MAKE) -C ../nextufs -f Makefile.linux libnextufs.a

clean:
	rm -f $(BIN)
	rm -rf .build-next

test: repair-smoke

repair-tools: scratch-dir
	$(MAKE) -C ../nextufs -f Makefile.linux nextufs_mkfile
	$(CC) $(CFLAGS) -I../nextufs -o $(REPAIR_TOOL_BIN) \
		$(TESTS_DIR)/tools/corrupt_raw_case.c \
		../nextufs/nextufs_dir_mutate.o ../nextufs/nextufs_mutate.o \
		../nextufs/libnextufs.a

repair-lab: repair-tools
	bash $(TESTS_DIR)/scripts/build_corpus.sh

repair-smoke: repair-lab $(BIN)
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n bad-block-count >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n bad-dot-inode >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n bad-dotdot-inode >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n bad-file-type >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n cg-bitmap-bad >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n cg-summary-bad >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n dir-entry-unallocated >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n dup-block >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n extraneous-dir-link >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n missing-dot >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n missing-dotdot >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n misaligned-dir-size >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n out-of-range-block >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n partial-indirect >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n partially-allocated-inode >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n root-not-dir >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n root-unallocated >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n short-dir >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n super-cstotal-bad >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n super-free-counts >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n super-minfree >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n super-optim >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n unreferenced-alpha >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n unreferenced-dir >/dev/null
	bash $(TESTS_DIR)/scripts/run_case.sh shipped -n zero-length-dir >/dev/null

repair-repair-all: repair-lab $(BIN)
	bash $(TESTS_DIR)/scripts/repair_all_cases.sh

repair-parity-smoke: repair-lab $(BIN)
	bash $(TESTS_DIR)/scripts/compare_case.sh -n cg-bitmap-bad >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n cg-summary-bad >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n dir-entry-fclear >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n dir-entry-unallocated >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n extra-dot >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n extra-dotdot >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n extraneous-dir-link >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n invalid-dir-inode >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n partial-indirect >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n root-not-dir >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n root-unallocated >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n super-cstotal-bad >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n super-free-counts >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n super-minfree >/dev/null
	bash $(TESTS_DIR)/scripts/compare_case.sh -n super-optim >/dev/null

repair-parity-all: repair-lab $(BIN)
	bash $(TESTS_DIR)/scripts/compare_all_cases.sh -n
